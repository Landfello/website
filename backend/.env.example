# Landfello API — set these in Render / Railway Dashboard → Environment
SECRET_KEY=change-me-to-a-long-random-string
FRONTEND_URL=https://website-zk2l.vercel.app
CORS_ORIGINS=https://website-zk2l.vercel.app,http://localhost:5173

# Required to download the SQLite backup: GET /api/admin/backup-db?token=...
DB_BACKUP_TOKEN=change-me-to-a-long-random-backup-token

# Optional — Dockerfile defaults to sqlite:////data/landfello.db
# DATABASE_URL=sqlite:////data/landfello.db
