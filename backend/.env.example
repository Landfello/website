# Landfello API — set these in Render Dashboard → Environment
SECRET_KEY=change-me-to-a-long-random-string
FRONTEND_URL=https://website-zk2l.vercel.app
CORS_ORIGINS=https://website-zk2l.vercel.app,http://localhost:5173

# Supabase Postgres session pooler URI (required). SQLite is not used.
# Dashboard → Project Settings → Database → Connection string (URI), Transaction pooler.
# Prefix with the SQLAlchemy driver:
# postgresql+psycopg://postgres.[ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+psycopg://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres

# Supabase Auth (Dashboard → Project Settings → API)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=lanfello
R2_PUBLIC_BASE_URL=https://YOUR_PUBLIC_R2_HOST
